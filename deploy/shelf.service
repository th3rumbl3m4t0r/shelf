[Unit]
Description=shelf file sharing
After=network-online.target
Wants=network-online.target

[Service]
User=shelf
Group=shelf
EnvironmentFile=/etc/shelf/shelf.env
# a rebuilt binary is a new file labelled usr_t, which would run unconfined
ExecStartPre=+/usr/sbin/restorecon /opt/shelf/target/release/shelf
ExecStart=/opt/shelf/target/release/shelf serve
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=yes
# port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/shelf
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
