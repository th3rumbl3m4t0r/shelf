# shelf settings (no secrets here; the key is /home/shelf/secret.key)
SHELF_DATA=/home/shelf
SHELF_BIND=0.0.0.0:80
# absolute base for public links once a front server exists, e.g. https://files.example.org
SHELF_PUBLIC_URL=
# 1 when served over https behind a proxy
SHELF_SECURE_COOKIE=0
# shown in the title bar (default: hostname)
SHELF_HOST=
# UPS status page (JSON): a backup when it leaves line power, pruning only on it
SHELF_UPS_URL=
